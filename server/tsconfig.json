{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ESNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    
    "jsx": "react-jsx",
    "isolatedModules": true
  },
  "include": ["src/**/*"],        
  "exclude": ["node_modules", "dist", "prisma"] 
}
